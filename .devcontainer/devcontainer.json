{
	"name": "OpenSTRAN development environment",
	"image": "dev-base:python",
	"initializeCommand": "mkdir -p ${localEnv:HOME}/.claude-docker",
	"mounts": [
		"source=${localEnv:HOME}/.claude-docker,target=/claude-state,type=bind"
	],
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/claude-state"
	},
	"runArgs":[
		"--name", "${localWorkspaceFolderBasename}"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.autopep8",
				"esbenp.prettier-vscode",
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.debugpy",
				"ms-python.vscode-python-envs",
				"ms-azuretools.vscode-containers"
			],
			"settings": {
				"python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
				"python.testing.pytestEnabled": true,
				"python.testing.unittestEnabled": false,
				"python.testing.pytestArgs": [
					"tests"
				]
			}
		}
	}
}
